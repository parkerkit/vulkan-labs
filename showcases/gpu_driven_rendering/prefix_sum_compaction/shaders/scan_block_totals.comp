#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

#include "scan_workspace.glsl"
#include "exclusive_scan.glsl"

layout(set = 0, binding = 2, std140) uniform CullingUniform {
    vec4 frustum_planes[6];
    uvec4 options;
} culling;

layout(set = 0, binding = 3, std430) writeonly buffer DrawCount {
    uint draw_count;
};

layout(set = 0, binding = 4, std430) buffer Visibility {
    uint workspace[];
};

void main() {
    uint block_index = gl_LocalInvocationIndex;
    uint object_count = culling.options.y;
    uint block_count = BlockCount(object_count);
    uint block_total = 0u;
    if (block_index < block_count) {
        block_total = workspace[BlockTotalIndex(object_count, block_index)];
    }
    uint visible_count;
    uint block_offset = ExclusiveScan(block_total, visible_count);
    if (block_index < block_count) {
        workspace[BlockOffsetIndex(object_count, block_index)] = block_offset;
    }
    if (block_index == 0u) {
        draw_count = visible_count;
    }
}
