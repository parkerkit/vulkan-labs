#version 450

layout(local_size_x = 64) in;

struct DrawIndexedIndirectCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

layout(set = 0, binding = 0, std430) readonly buffer Objects {
    vec4 spheres[];
};

layout(set = 0, binding = 1, std430) writeonly buffer IndirectCommands {
    DrawIndexedIndirectCommand commands[];
};

layout(set = 0, binding = 2, std140) uniform CullingUniform {
    vec4 frustum_planes[6];
    vec4 view_depth;
    vec4 lod_parameters;
    uvec4 options;
    uvec4 meshes[3];
} culling;

layout(set = 0, binding = 3, std430) buffer LodStats {
    uint draw_count;
    uint lod_counts[3];
} stats;

bool IsVisible(vec4 sphere) {
    if (culling.options.x == 0u) {
        return true;
    }
    for (int plane_index = 0; plane_index < 6; ++plane_index) {
        if (dot(culling.frustum_planes[plane_index], vec4(sphere.xyz, 1.0)) < -sphere.w) {
            return false;
        }
    }
    return true;
}

uint SelectLod(vec4 sphere) {
    float depth = dot(culling.view_depth, vec4(sphere.xyz, 1.0));
    if (culling.options.y != 0u || depth <= sphere.w) {
        return 0u;
    }
    // 以球心视空间深度近似投影直径。视口高度乘投影系数，将结果换算为像素。
    float diameter_pixels = sphere.w * culling.lod_parameters.x / depth;
    if (diameter_pixels >= culling.lod_parameters.y) {
        return 0u;
    }
    return diameter_pixels >= culling.lod_parameters.z ? 1u : 2u;
}

void main() {
    uint object_index = gl_GlobalInvocationID.x;
    if (object_index >= uint(spheres.length())) {
        return;
    }
    vec4 sphere = spheres[object_index];
    if (!IsVisible(sphere)) {
        return;
    }

    uint lod = SelectLod(sphere);
    uvec4 mesh = culling.meshes[lod];
    uint draw_index = atomicAdd(stats.draw_count, 1u);
    atomicAdd(stats.lod_counts[lod], 1u);
    // firstInstance 选择对象记录，vertexOffset 选择共享顶点缓冲中的网格范围。
    commands[draw_index] = DrawIndexedIndirectCommand(mesh.x, 1u, mesh.y, int(mesh.z), object_index);
}
