#version 450
#extension GL_EXT_mesh_shader : require

// 与 main.cpp 中的 meshlet 上限和工作组大小保持一致。
layout(local_size_x = 32) in;
layout(triangles, max_vertices = 64, max_primitives = 128) out;

layout(set = 0, binding = 0) uniform UniformBufferObject
{
    mat4 model;
    mat4 view;
    mat4 proj;
} ubo;

struct MeshletInfo
{
    uint vertex_offset;
    uint triangle_offset;
    uint vertex_count;
    uint triangle_count;
};

layout(std430, set = 0, binding = 1) readonly buffer Positions
{
    vec4 positions[];
};

layout(std430, set = 0, binding = 2) readonly buffer Meshlets
{
    MeshletInfo meshlets[];
};

layout(std430, set = 0, binding = 3) readonly buffer MeshletVertices
{
    uint meshlet_vertices[];
};

layout(std430, set = 0, binding = 4) readonly buffer MeshletTriangles
{
    uint meshlet_triangles[];
};

layout(push_constant) uniform DrawParams
{
    uint base_meshlet;
} draw_params;

// 只输出实际使用的内建变量，使输出内存需求明确。
out gl_MeshPerVertexEXT
{
    vec4 gl_Position;
} gl_MeshVerticesEXT[];

layout(location = 0) flat out vec3 frag_color[];

vec3 GetMeshletColor(uint meshlet_index)
{
    uint hash_value = (meshlet_index + 1u) * 747796405u + 2891336453u;
    hash_value = ((hash_value >> ((hash_value >> 28u) + 4u)) ^ hash_value) * 277803737u;
    hash_value = (hash_value >> 22u) ^ hash_value;
    return vec3(0.25) + 0.75 * vec3(hash_value & 255u, (hash_value >> 8u) & 255u,
                                  (hash_value >> 16u) & 255u) / 255.0;
}

void main()
{
    uint meshlet_index = draw_params.base_meshlet + gl_WorkGroupID.x;
    MeshletInfo meshlet = meshlets[meshlet_index];
    SetMeshOutputsEXT(meshlet.vertex_count, meshlet.triangle_count);

    vec3 color = GetMeshletColor(meshlet_index);
    mat4 transform = ubo.proj * ubo.view * ubo.model;
    for (uint i = gl_LocalInvocationIndex; i < meshlet.vertex_count; i += gl_WorkGroupSize.x)
    {
        uint vertex_index = meshlet_vertices[meshlet.vertex_offset + i];
        gl_MeshVerticesEXT[i].gl_Position = transform * positions[vertex_index];
        frag_color[i] = color;
    }

    for (uint i = gl_LocalInvocationIndex; i < meshlet.triangle_count; i += gl_WorkGroupSize.x)
    {
        uint offset = meshlet.triangle_offset + i * 3u;
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(meshlet_triangles[offset], meshlet_triangles[offset + 1u],
                                                meshlet_triangles[offset + 2u]);
    }
}
